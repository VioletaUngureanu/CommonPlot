# ============================================================
#  schema.graphqls — Gold challenge
#  Books + Meetups + relație 1-to-many
# ============================================================

# ── Types ─────────────────────────────────────────────────────

type Book {
    id: ID!
    title: String!
    author: String!
    description: String
    coverUrl: String
}

type Meetup {
    id: ID!
    titleEvent: String!
    location: String!
    date: String!
    bookID: Int
    bookTitle: String
    bookAuthor: String
    ownerID: Int!
    ownerUsername: String!
    duration: Int!
    rating: Float
    description: String
}

type PagedMeetups {
    content: [Meetup!]!
    page: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    first: Boolean!
    last: Boolean!
}

type MeetupStats {
    total: Int!
    averageRating: Float!
}

type BookMeetupStats {
    bookId: Int!
    totalMeetups: Int!
    avgRating: Float!
    avgDuration: Int!
}

type LocationStat {
    location: String!
    count: Int!
}

type BookStat {
    book: String!
    count: Int!
}

# ── Queries ───────────────────────────────────────────────────

type Query {
    # Meetups
    meetups(page: Int, size: Int): PagedMeetups!
    meetup(id: ID!): Meetup
    meetupStats: MeetupStats!
    statsByLocation: [LocationStat!]!
    statsByBook: [BookStat!]!

    # Books
    books: [Book!]!
    book(id: ID!): Book
    meetupsByBook(bookId: Int!): [Meetup!]!
    bookStats(bookId: Int!): BookMeetupStats!
}

# ── Mutations ─────────────────────────────────────────────────

type Mutation {
    # Meetups
    createMeetup(input: MeetupInput!): Meetup!
    updateMeetup(id: ID!, input: MeetupInput!): Meetup
    deleteMeetup(id: ID!): Boolean!
    startGenerator(interval: Int): Boolean!
    stopGenerator: Boolean!

    # Books
    createBook(input: BookInput!): Book!
    updateBook(id: ID!, input: BookInput!): Book
    deleteBook(id: ID!): Boolean!
}

# ── Inputs ────────────────────────────────────────────────────

input MeetupInput {
    titleEvent: String!
    location: String!
    date: String!
    bookID: Int!
    bookTitle: String
    bookAuthor: String
    ownerID: Int!
    ownerUsername: String!
    duration: Int!
    rating: Float
    description: String
}

input BookInput {
    title: String!
    author: String!
    description: String
    coverUrl: String
}
